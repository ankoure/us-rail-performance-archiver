# data
archive/
data/
*.parquet
*.jsonl
*.bin

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# rust (rail-decoder) — local build artifacts; the rust-builder stage COPYs
# rail-decoder/ directly, so leaving these in would bust that stage's cache
# on every local cargo build/maturin develop.
rail-decoder/target/
rail-decoder/.venv/

# separately-deployed / not needed in this image
# dashboard/api -> Vercel, dashboard/web -> static export build, terraform -> IaC only
dashboard/
terraform/

# vcs / ci
.git/
.github/

# secrets / local
.env
# config/feeds.yaml IS baked in (no secrets — only env-var names; agency keys come
# from Secrets Manager / .env at runtime) so the Fargate rollup task, which has no
# volume mount, can read it. The poller still mounts ./config over the baked copy.
# Keep the large local-only candidate lists out of the image.
config/feeds.candidates*.yaml