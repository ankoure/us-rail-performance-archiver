    {
      "definition": {
        "type": "group",
        "layout_type": "ordered",
        "title": "ECS runtime cost (estimated)",
        "widgets": [
          {
            "definition": {
              "type": "note",
              "content": "Estimated from pipeline.task.duration (wall clock of the whole rollup/snapshot/gold/ship/cert_check Fargate task, emitted by pipeline/task_duration.py via a shell `trap ... EXIT` so a failed run still counts) x on-demand Fargate list pricing for the task's fixed size (4 vCPU / 8 GiB — terraform var.rollup_cpu/rollup_memory). Rates as of 2026-08-02, us-east-1: $0.04048/vCPU-hr, $0.004445/GB-hr. The task actually runs on FARGATE_SPOT, so real cost is typically lower and fluctuates with market rate — this is a conservative upper bound, not a live Spot price. One scheduled run/day (cron 30 3 * * ? *).",
              "background_color": "gray",
              "font_size": "14",
              "text_align": "left",
              "show_tick": false
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Last run duration (min)",
              "precision": 1,
              "autoscale": false,
              "time": { "live_span": "1d" },
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "duration_ms",
                      "data_source": "metrics",
                      "query": "avg:pipeline.task.duration.avg{$env, service:rail-archiver}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [{ "formula": "duration_ms / 60000" }]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Est. cost per run ($)",
              "precision": 3,
              "custom_unit": "$",
              "autoscale": false,
              "time": { "live_span": "1d" },
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "duration_ms",
                      "data_source": "metrics",
                      "query": "avg:pipeline.task.duration.avg{$env, service:rail-archiver}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "(duration_ms / 3600000) * (4 * 0.04048 + 8 * 0.004445)"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Projected monthly ECS cost (est. $ = per-run x 30)",
              "precision": 2,
              "custom_unit": "$",
              "autoscale": false,
              "time": { "live_span": "1d" },
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "name": "duration_ms",
                      "data_source": "metrics",
                      "query": "avg:pipeline.task.duration.avg{$env, service:rail-archiver}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "(duration_ms / 3600000) * (4 * 0.04048 + 8 * 0.004445) * 30"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "pipeline.task.duration per run (minutes)",
              "show_legend": false,
              "yaxis": { "label": "min", "include_zero": true },
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "queries": [
                    {
                      "name": "duration_ms",
                      "data_source": "metrics",
                      "query": "avg:pipeline.task.duration.avg{$env, service:rail-archiver}"
                    }
                  ],
                  "formulas": [{ "formula": "duration_ms / 60000" }]
                }
              ]
            }
          }
        ]
      }
    }
  ]
